# Application
NEXT_PUBLIC_APP_NAME=ワンちゃんオーダーメイド
NEXT_PUBLIC_APP_URL=https://example.com

# Environment
NODE_ENV=production

# Analytics (optional)
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GTM_ID=

# API Endpoints (for future use)
NEXT_PUBLIC_API_URL=

# Feature Flags
NEXT_PUBLIC_ENABLE_3D_PREVIEW=true
NEXT_PUBLIC_ENABLE_CART=false
NEXT_PUBLIC_ENABLE_PAYMENT=false

# AWS (server-side only, do not prefix with NEXT_PUBLIC_)
AWS_REGION=ap-northeast-1
AWS_S3_BUCKET=
AWS_CLOUDFRONT_DISTRIBUTION_ID=

# Email (for future use)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
